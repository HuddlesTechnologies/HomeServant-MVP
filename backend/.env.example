# Copy to .env for local development. On Render, set these as environment
# variables on the service instead of committing a real .env file.

# Supabase Postgres. Project Settings > Database on the Supabase
# dashboard gives you both of these:
#   DATABASE_URL — "Connection pooling" URI, port 6543, with
#     ?pgbouncer=true appended. Used for normal request traffic.
#   DIRECT_URL   — "Connection string" URI, port 5432. Used only for
#     `prisma migrate`, which needs a direct (non-pooled) connection.
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Long, random secrets — generate with `openssl rand -hex 32`. Never reuse
# the same secret for both.
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Comma-separated list of origins allowed to call this API — the deployed
# Flutter web build's origin(s), plus http://localhost:* while developing.
CORS_ORIGINS="http://localhost:8765"

PORT=3000

# --- OTP delivery -----------------------------------------------------
# Left unset, OtpService logs the code to the server console instead of
# sending it — fine for development, not for production. Wire a real
# provider (Termii for Nigerian SMS, Resend/SendGrid for email) in
# src/otp/providers before going live; see that folder's README note.
OTP_PROVIDER="console"

# --- Object storage (Supabase Storage) ---------------------------------
# Project Settings > API on the Supabase dashboard. The service role key
# bypasses Row Level Security — it's used server-side only, to mint
# short-lived signed upload URLs, and must never reach the Flutter client.
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="change-me"
# Storage bucket to upload into — create it in Supabase Storage first
# (Storage > New bucket). Public so uploaded images are directly
# viewable via their public URL without a signed read.
SUPABASE_STORAGE_BUCKET="homeservant-uploads"

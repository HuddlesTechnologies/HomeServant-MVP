// HomeServant API data model — v1. Covers auth, profiles, properties,
// bookings, favorites, reviews, chat, and the marketplace (vendors,
// products, orders): the pieces the app's screens actually call today.
// Tenancy agreement storage is intentionally not modelled yet — see
// backend/README.md for that roadmap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase's pooled connection (port 6543, pgbouncer) — used for normal
  // query traffic. Migrations use directUrl instead since the pooler's
  // transaction mode doesn't support the prepared statements/advisory
  // locks `prisma migrate` needs.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  TENANT
  LANDLORD
  VENDOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

/// Ranked low to high — AdminLevelGuard compares enum index, so the
/// declaration order here *is* the hierarchy (SUPPORT < MODERATOR <
/// SUPER_ADMIN). Reordering these values changes every endpoint's
/// effective minimum level.
enum AdminLevel {
  SUPPORT
  MODERATOR
  SUPER_ADMIN
}

enum PropertyCategory {
  HOUSE
  SHORTLET
  SELF_CON
  APARTMENT
}

enum PriceUnit {
  YEAR
  NIGHT
}

/// Current (non-Shortlet) rental flow: tenant pays immediately on request
/// (no landlord pre-approval to charge them) -> PAID_AWAITING_INSPECTION
/// (held in escrow, no inspection date chosen yet — this is also where a
/// tenant who picked "book later" sits, reachable again any time from
/// their booking history) -> INSPECTION_PROPOSED (tenant picked a date) ->
/// landlord either confirms (INSPECTION_CONFIRMED) or declines just that
/// date (back to PAID_AWAITING_INSPECTION, tenant can propose again/defer/
/// refund) -> MOVED_IN (escrow released, lease active) once the tenant
/// confirms they've moved in. At any point before MOVED_IN: the tenant can
/// request REFUNDED (their own choice, 0.2% fee withheld — see
/// PaymentsService.refundBookingBeforeMoveIn), or the landlord can reject
/// the booking outright via DECLINED (a distinct lever from just declining
/// an inspection date — full refund, no fee, see
/// PaymentsService.rejectBooking).
///
/// PENDING/ACCEPTED/PAID predate this flow and are no longer written by
/// new bookings — left in the enum rather than removed since existing
/// rows may still reference them. A Shortlet booking is unaffected by any
/// of this: it skips inspection entirely and goes straight to PAID on
/// instant payment (no MOVED_IN click exists for a short stay) — see
/// BookingsService/PaymentsService.releaseShortletInstant.
enum BookingStatus {
  PENDING
  ACCEPTED
  PAID
  PAID_AWAITING_INSPECTION
  INSPECTION_PROPOSED
  INSPECTION_CONFIRMED
  MOVED_IN
  DECLINED
  REFUNDED
}

enum OtpPurpose {
  SIGNUP
  LOGIN_2FA
  PASSWORD_RESET
  ADMIN_CREATE
  ADMIN_RESET_CONFIRM
}

enum MarketplaceCategory {
  FURNITURE
  HOME_APPLIANCES
  ELECTRONICS
  FITTINGS_FIXTURES
  DECOR
  TOOLS_EQUIPMENT
  OTHER
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum MarketplacePaymentMethod {
  CARD
  BANK_TRANSFER
}

enum OrderItemStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentPurpose {
  RENTAL_BOOKING
  MARKETPLACE_ORDER_ITEM
}

/// INITIATED (charge started, webhook not yet confirmed) -> PAID_HELD
/// (charge confirmed, funds sit in HomeServant's own Paystack balance) ->
/// RELEASED (Transfer sent to the recipient's bank account) / REFUNDED
/// (Paystack refund issued to the payer) / FAILED (charge never
/// succeeded).
enum PaymentStatus {
  INITIATED
  PAID_HELD
  RELEASED
  REFUNDED
  FAILED
}

/// The escrow ledger — one row per charge, for either a rental Booking or
/// a single MarketplaceOrderItem (never both; exactly one of bookingId/
/// orderItemId is set, matching [purpose]). [platformFeeAmount] is 5% of
/// [amount] for a normal release (marketplace, shortlet, or rental
/// move-in) or 0.2% of [amount] for a rental refunded before move-in —
/// see PaymentsService for the exact math. A Booking can have more than
/// one Payment over time (a renewal charges again), so [bookingId] isn't
/// unique; an order item is only ever paid for once, so [orderItemId] is.
model Payment {
  id                    String                @id @default(uuid())
  purpose               PaymentPurpose
  bookingId             String?
  booking               Booking?              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  orderItemId           String?               @unique
  orderItem             MarketplaceOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  payerId               String
  payer                 User                  @relation("PaymentsMade", fields: [payerId], references: [id], onDelete: Cascade)
  /// The landlord's or vendor's User id — resolved at charge time so the
  /// eventual Transfer always has a fixed target even if, say, the
  /// property changes hands later.
  recipientUserId       String
  recipient             User                  @relation("PaymentsReceived", fields: [recipientUserId], references: [id], onDelete: Cascade)
  /// Amount actually charged to the payer, in kobo.
  amount                Int
  /// HomeServant's cut, in kobo (already reflected in what the recipient
  /// is transferred — recipient gets amount - platformFeeAmount).
  platformFeeAmount     Int
  paystackReference     String                @unique
  transferRecipientCode String?
  status                PaymentStatus         @default(INITIATED)
  paidAt                DateTime?
  releasedAt            DateTime?
  refundedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([bookingId])
  @@index([status])
}

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  phoneNumber          String?
  /// Null for a Google-only account — nothing to compare a login password
  /// against, so AuthService.login rejects the password grant entirely
  /// for these users instead of hashing/comparing against nothing.
  passwordHash         String?
  /// Google's `sub` claim — stable even if the user's email changes on
  /// their Google account. Null until they've signed in with Google at
  /// least once (including an account originally created by
  /// email/password, if they later link Google to the same email).
  googleId             String?        @unique
  role                 UserRole
  /// Only meaningful when [role] is ADMIN — which admin console actions
  /// this account can take (see AdminLevelGuard). Null for every other
  /// role.
  adminLevel           AdminLevel?
  firstName            String?
  lastName             String?
  fullName             String?
  houseAddress         String?
  dateOfBirth          DateTime?
  profilePhotoUrl      String?
  /// Tenant profile fields a landlord can see for someone renting (or
  /// requesting to rent) their property — see BookingsService.findForLandlord,
  /// which is the only place these are exposed to another user. Optional on
  /// every role (not just TENANT) since a landlord/vendor account's own
  /// profile-edit screen can reuse the same fields.
  gender               Gender?
  occupation           String?
  maritalStatus        MaritalStatus?
  emailVerifiedAt      DateTime?
  twoFactorEnabled     Boolean        @default(false)
  /// Set true for an admin account created via the console's invite-by-
  /// email flow (AdminService.confirmAdminOtp) — signed in with the
  /// one-time password from that invite email. AuthService.changePassword
  /// clears it. The Flutter admin console checks this right after login
  /// and blocks entry into the console behind a mandatory "set your
  /// password" step until it's cleared.
  mustChangePassword   Boolean        @default(false)
  /// Set by `PATCH /auth/deactivate` (Settings > Danger Zone). Hides this
  /// landlord's properties from the public feed and every session gets
  /// signed out; cleared automatically the next time this account logs
  /// in successfully (see AuthService.login/googleAuth), matching the
  /// "reactivate any time by logging back in" promise on that screen.
  deactivatedAt        DateTime?
  /// Updated on every successful login (every role, not just ADMIN — see
  /// AuthService.login/verifyLoginOtp/googleAuth) and again the moment a
  /// user's last open socket disconnects (see PresenceService/ChatGateway)
  /// — the "last active" timestamp the admin console and chat participant
  /// list both read. Null only for an account that's never logged in
  /// (created by an admin invite, etc.) or connected a chat socket yet.
  lastActiveAt         DateTime?
  /// Captured from the request at login time — same data
  /// ActivityLog already records for ADMIN_LOGIN, just now kept on every
  /// role's own row instead of only in the (admin-only) activity log.
  lastLoginIp          String?
  /// Client-supplied at login (see LoginDto/VerifyLoginOtpDto's
  /// `deviceModel`) — e.g. "iPhone 14 Pro" or "Pixel 7". Null for a
  /// session that predates this field or a client that didn't send one
  /// (web, older app build).
  lastLoginDeviceModel String?
  /// Landlord payout account — the account a tenant's payment is credited
  /// to. [accountName] is never taken from client input; it's only ever
  /// set from Paystack's own account-resolution response, so it can't be
  /// spoofed to redirect payouts to an unverified account.
  bankCode             String?
  bankName             String?
  accountNumber        String?
  accountName          String?
  /// This user's own invite code, shown on "Invite Friends" — nullable
  /// only because it's backfilled lazily on first access for accounts
  /// that existed before this field did (see UsersService.findById)
  /// rather than requiring a data migration for every existing row.
  referralCode         String?        @unique
  /// Set the first time this user signs up with someone else's referral
  /// code (via `PATCH /users/me`, see UsersService.updateProfile) — never
  /// overwritten afterward, so a code entered later can't retroactively
  /// steal credit for an account that already has an inviter.
  referredById         String?
  referredBy           User?          @relation("Referrals", fields: [referredById], references: [id])
  referrals            User[]         @relation("Referrals")
  /// Set once the referrer's "so-and-so signed up with your code"
  /// notification has actually been sent, guarding against sending it
  /// twice if [fullName] is updated more than once after the referral
  /// link is made.
  referralNotifiedAt   DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  properties             Property[]          @relation("LandlordProperties")
  bookings               Booking[]           @relation("TenantBookings")
  favorites              Favorite[]
  refreshTokens          RefreshToken[]
  otpCodes               OtpCode[]
  reviews                Review[]
  threadMemberships      ThreadParticipant[]
  messages               Message[]
  vendorProfile          VendorProfile?
  marketplaceOrders      MarketplaceOrder[]
  notifications          Notification[]
  activityActions        ActivityLog[]       @relation("ActivityActor")
  activityTargets        ActivityLog[]       @relation("ActivityTarget")
  reportsFiled           Report[]            @relation("ReportsFiled")
  reportsAssigned        Report[]            @relation("ReportsAssigned")
  paymentsMade           Payment[]           @relation("PaymentsMade")
  paymentsReceived       Payment[]           @relation("PaymentsReceived")
  supportThreadsAssigned Thread[]            @relation("SupportThreadsAssigned")
  threadTransfersFrom    ThreadTransferLog[] @relation("ThreadTransfersFrom")
  threadTransfersTo      ThreadTransferLog[] @relation("ThreadTransfersTo")

  @@index([role])
}

enum ActivityLogType {
  ADMIN_LOGIN
  ADMIN_PASSWORD_CHANGED
  ADMIN_PASSWORD_RESET
  /// An admin edited another user's basic profile fields (name/phone/
  /// house address) via `PATCH /admin/users/:id` — the one mutation every
  /// admin tier (including SUPPORT) can perform, so it's logged like every
  /// other admin action for auditability.
  ADMIN_USER_EDITED
  /// A SUPER_ADMIN wiped the *entire* activity log (every type at once) —
  /// see ActivityLogService.clear. Written as the one surviving row right
  /// after the wipe, so there's still a record of who did it. Clearing a
  /// single type (not the whole log) is intentionally NOT logged — see
  /// AdminService.clearActivityLog's doc comment for why.
  ADMIN_ACTIVITY_LOG_CLEARED
  /// An admin claimed an unattended support thread, either explicitly
  /// (opening it from the Support Queue) or implicitly (being the first to
  /// reply) — see ChatService.claimThread/attemptClaim.
  SUPPORT_THREAD_CLAIMED
  /// An admin handed a support (or any) thread off to another admin — see
  /// ChatService.transferThread. [actorId] is the admin who transferred it
  /// away, [targetId] is the admin it was transferred to.
  SUPPORT_THREAD_TRANSFERRED
  /// An admin marked a support thread resolved — see
  /// ChatService.resolveSupportThread.
  SUPPORT_THREAD_RESOLVED
}

/// Site-wide admin audit trail (Activity Log console section) — every
/// admin login and every admin password change/reset writes one of
/// these. [actorId] is who performed the action; [targetId] is who it
/// was performed on (same person for a login or a self-service password
/// change, a different admin for AdminService.confirmAdminPasswordReset).
/// Both nullable with onDelete: SetNull so deleting an admin account
/// later doesn't erase the historical record, just the identity link.
model ActivityLog {
  id        String          @id @default(uuid())
  type      ActivityLogType
  actorId   String?
  actor     User?           @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetId  String?
  target    User?           @relation("ActivityTarget", fields: [targetId], references: [id], onDelete: SetNull)
  ip        String?
  /// Best-effort city/country from a free IP-geolocation lookup — absent
  /// if that lookup failed or timed out; never blocks the action itself.
  location  String?
  createdAt DateTime        @default(now())

  @@index([createdAt])
}

enum ReportTargetType {
  PROPERTY
  MARKETPLACE_ITEM
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

/// A tenant can only report a Property they've actually rented (an
/// ACCEPTED Booking); a buyer can only report a Product they've actually
/// bought (a MarketplaceOrderItem on one of their orders) — enforced in
/// ReportsService, not at the schema level.
model Report {
  id              String           @id @default(uuid())
  reporterId      String
  reporter        User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType      ReportTargetType
  propertyId      String?
  property        Property?        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  reason          String
  status          ReportStatus     @default(OPEN)
  assignedAdminId String?
  assignedAdmin   User?            @relation("ReportsAssigned", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
}

enum NotificationType {
  REFERRAL_SIGNUP
  VENDOR_APPROVED
  VENDOR_REJECTED
  BOOKING_STATUS
  MARKETPLACE_ORDER_STATUS
  REPORT_ASSIGNED
  THREAD_TRANSFERRED
  NEW_MESSAGE
  VENDOR_SUSPENDED
  VENDOR_UNSUSPENDED
  /// 30 days / 15 days / day-of reminder that a tenant's lease is about to
  /// expire — sent by the lease-lifecycle cron, see BookingsCronService.
  RENT_EXPIRY_REMINDER
  /// The first message in a thread that started from a property listing —
  /// distinct from the generic NEW_MESSAGE every later message in that
  /// same thread still gets, since only the first one also triggers an
  /// email to the landlord (see ChatService.sendMessage).
  NEW_LISTING_MESSAGE
  /// An admin marked a "Contact Support" thread resolved — see
  /// ChatService.resolveSupportThread.
  SUPPORT_THREAD_RESOLVED
}

/// A user-facing notification — modelled generically so
/// other real events (booking updates, new messages, etc.) have a real
/// home instead of the client's previous hardcoded mock list.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

/// Hashed refresh tokens, one row per issued token — lets a single token
/// be revoked (logout, password change) without invalidating every
/// session, and supports rotation (each refresh issues a new row and
/// revokes the old one).
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// One-time codes for signup verification, login 2FA, and password reset.
/// [destination] is the email/phone the code was actually sent to, kept
/// separate from the user's current contact info in case that changes
/// before the code is used or expires.
model OtpCode {
  id          String     @id @default(uuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String
  codeHash    String
  purpose     OtpPurpose
  /// Failed verify attempts against this specific code — capped in
  /// OtpService so a 4-digit code (10,000 possibilities) can't just be
  /// brute-forced within its expiry window.
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([destination, purpose])
}

/// An admin invite waiting on its ADMIN_CREATE OTP to be confirmed from
/// the console (see AdminService.requestAdminOtp/confirmAdminOtp) — no
/// User row exists yet for [email] at this point, so the details entered
/// on the "New Admin" form have to live somewhere between the two steps.
/// Deleted once confirmed (or replaced if requested again for the same
/// email before that happens).
model PendingAdmin {
  id               String     @id @default(uuid())
  email            String     @unique
  fullName         String
  level            AdminLevel
  tempPasswordHash String
  createdAt        DateTime   @default(now())
}

model Property {
  id                 String           @id @default(uuid())
  /// System-assigned, sequential and unique across every property ever
  /// listed (independent of Product.listingNumber's own sequence) — the
  /// human-facing identifier shown to landlords/admins always, and to a
  /// tenant only once they've paid (see PropertiesService/AdminService
  /// callers and the Flutter Property.fromApi doc comment).
  listingNumber      Int              @unique @default(autoincrement())
  landlordId         String
  landlord           User             @relation("LandlordProperties", fields: [landlordId], references: [id], onDelete: Cascade)
  title              String
  location           String
  state              String
  category           PropertyCategory
  price              Int
  priceUnit          PriceUnit
  bedrooms           Int
  bathrooms          Int
  description        String
  imageUrl           String?
  galleryUrls        String[]         @default([])
  /// True once a tenant has moved into an accepted, paid lease on this
  /// property (see BookingsService.confirmMovedIn) — hides it from public
  /// search. Never set for a SHORTLET booking (see [category]); those
  /// stay visible with a "currently unavailable" state derived from
  /// whether an active Booking's leaseEndDate is still in the future,
  /// rather than this flag, so the listing itself keeps taking future
  /// bookings around the current stay.
  isOccupied         Boolean          @default(false)
  /// Set by the landlord at listing time for every non-Shortlet category
  /// — how long a lease runs once a tenant moves in (6-24 months).
  /// Meaningless for SHORTLET, where a stay's length instead comes from
  /// however many nights the tenant books.
  rentDurationMonths Int?
  /// Off hides the "Message" action on this specific listing and blocks
  /// starting a new thread from it — replaces the old device-local,
  /// unsynced AppState toggle of the same intent.
  messagingEnabled   Boolean          @default(true)
  /// Shortlet-only — the unit's exact address/room within [location],
  /// since one shortlet listing is a single bookable unit.
  unitAddress        String?
  roomNumber         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  bookings  Booking[]
  favorites Favorite[]
  reviews   Review[]
  threads   Thread[]
  reports   Report[]

  @@index([landlordId])
  @@index([state, category])
}

/// One review per tenant per property (the unique constraint), rather
/// than per-booking — simpler for v1, matches the rest of the app not
/// yet distinguishing "which stay" a rating is about.
model Review {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([propertyId, authorId])
  @@index([propertyId])
}

/// A conversation between two or more users, optionally about a specific
/// property (e.g. "Message Landlord" from a property detail screen).
/// Membership lives in [ThreadParticipant] rather than fixed columns so
/// this isn't locked to exactly two people if group threads are ever
/// needed.
model Thread {
  id              String            @id @default(uuid())
  propertyId      String?
  property        Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  /// Set instead of propertyId for a marketplace pickup-coordination
  /// thread (buyer <-> vendor about a specific order) — mutually
  /// exclusive with propertyId in practice, though nothing enforces that
  /// at the schema level since a thread with neither is also valid (not
  /// used today, but not wrong).
  orderId         String?
  order           MarketplaceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// True for a "Contact Support" thread (started via `POST
  /// /threads/support`, not the normal `POST /threads`) — these show up in
  /// every admin's shared Support Queue rather than only for a specific
  /// participant, and are the only threads the 30-day cleanup cron and the
  /// "hide once resolved" rule (see [status]) apply to.
  isSupport       Boolean           @default(false)
  status          ThreadStatus      @default(OPEN)
  /// The admin who claimed this support thread — set automatically the
  /// first time any admin replies (see ChatService.sendMessage), the same
  /// "first responder claims it" idea Report.assignedAdminId already uses.
  /// Always null for a non-support thread.
  assignedAdminId String?
  assignedAdmin   User?             @relation("SupportThreadsAssigned", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  /// Set once an admin marks a support thread resolved — from that point
  /// [findForUser] hides it from the *user's* inbox (not the admin's; the
  /// 30-day cleanup cron is what eventually removes it for everyone).
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  participants ThreadParticipant[]
  messages     Message[]
  transferLogs ThreadTransferLog[]

  @@index([propertyId])
  @@index([orderId])
  @@index([isSupport, status])
}

enum ThreadStatus {
  OPEN
  RESOLVED
}

/// One row per transfer of a thread from one admin to another — unlike
/// [Thread.assignedAdminId] (which only ever holds the *current* handler),
/// this is append-only, so the super-admin Chat Log can show the full chain
/// of everyone who has ever held a conversation, not just whoever holds it
/// now. Cascades with its Thread, so it's purged by the same 30-day support
/// cleanup cron that already deletes old support threads/messages — no
/// separate retention job needed.
model ThreadTransferLog {
  id          String   @id @default(uuid())
  threadId    String
  thread      Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromAdminId String?
  fromAdmin   User?    @relation("ThreadTransfersFrom", fields: [fromAdminId], references: [id], onDelete: SetNull)
  toAdminId   String?
  toAdmin     User?    @relation("ThreadTransfersTo", fields: [toAdminId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([threadId])
}

model ThreadParticipant {
  id       String @id @default(uuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

enum MessageType {
  TEXT
  /// The very first message in a thread that started from a property
  /// listing — rendered as a preview card (title/price/image) instead of
  /// a text bubble, for both participants. The preview fields below are a
  /// snapshot taken at send time (same convention as
  /// MarketplaceOrderItem.productName/unitPrice) so the card stays
  /// accurate even if the listing's price changes or the listing is
  /// later removed.
  PROPERTY_PREVIEW
}

/// Persisted through this API (so history survives even if a client never
/// opened a Realtime connection); Supabase Realtime is layered on top for
/// live delivery — see backend/README.md. [senderId] is nullable with
/// onDelete: SetNull (not Cascade) specifically so that when a sender's
/// account is later deleted (self-deactivation cleanup or an admin
/// delete), their past messages stay in the other participant's thread
/// instead of vanishing — matching this model's own "history survives"
/// intent, which a straight Cascade would have silently violated.
model Message {
  id                       String      @id @default(uuid())
  threadId                 String
  thread                   Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId                 String?
  sender                   User?       @relation(fields: [senderId], references: [id], onDelete: SetNull)
  type                     MessageType @default(TEXT)
  body                     String
  previewPropertyTitle     String?
  previewPropertyImageUrl  String?
  previewPropertyPrice     Int?
  previewPropertyPriceUnit PriceUnit?
  readAt                   DateTime?
  createdAt                DateTime    @default(now())

  @@index([threadId, createdAt])
}

model Booking {
  id                      String        @id @default(uuid())
  propertyId              String
  property                Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId                String
  tenant                  User          @relation("TenantBookings", fields: [tenantId], references: [id], onDelete: Cascade)
  status                  BookingStatus @default(PENDING)
  /// The tenant's proposed date — an inspection date for a non-Shortlet
  /// rental, or the requested check-in date for a Shortlet (which has no
  /// inspection step, see BookingStatus). Confirmed by the landlord via
  /// [inspectionConfirmedAt] (non-Shortlet only); nothing here supports
  /// the landlord counter-proposing a different date — they only accept
  /// or decline the one the tenant asked for.
  requestedDate           DateTime?
  inspectionConfirmedAt   DateTime?
  /// Shortlet-only — number of nights requested/booked (ignored for a
  /// non-Shortlet booking). Combined with [requestedDate] at webhook time
  /// to compute leaseEndDate = requestedDate + nights on instant payment
  /// release — see PaymentsService.
  nights                  Int?
  /// Property.price/priceUnit at the moment this booking was charged — a
  /// later price change on the listing shouldn't retroactively change
  /// what this tenant owes (same convention as
  /// MarketplaceOrderItem.unitPrice). Re-snapshotted on each renewal, since
  /// a landlord may reasonably raise rent at renewal time.
  priceSnapshot           Int?
  priceUnitSnapshot       PriceUnit?
  /// Set together when payment is released (Shortlet: right after instant
  /// payment; a normal rental: when the tenant clicks "Moved In"). [leaseEndDate]
  /// is [leaseStartDate] plus Property.rentDurationMonths (or the
  /// Shortlet's booked night count) — the lease-lifecycle cron reads this
  /// to auto-expire/relist and to send the 30/15/0-day reminders.
  leaseStartDate          DateTime?
  leaseEndDate            DateTime?
  /// De-dupes the lease-lifecycle cron's 30/15/0-day rent-expiry
  /// reminder — set to whichever of 30/15/0 was last sent, so a daily
  /// tick doesn't re-send the same threshold every day it's still true.
  /// Reset to null on a successful renewal (a new leaseEndDate starts a
  /// new reminder cycle).
  lastRentReminderDaysOut Int?
  message                 String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  payments         Payment[]
  tenancyAgreement TenancyAgreement?

  @@index([propertyId])
  @@index([tenantId])
  @@index([leaseEndDate])
}

/// Generated once, at the moment a rental Booking's payment is released
/// (tenant clicked "Moved In") — a persisted snapshot of both parties and
/// the lease terms, replacing the client-side fabrication that used to
/// invent a lease end date and hardcode the landlord's details as
/// "on file with Home Servant". Immutable after creation; a renewal
/// updates the same Booking's leaseEndDate but does not regenerate this
/// row, since the original agreement's terms still stand.
model TenancyAgreement {
  id               String    @id @default(uuid())
  bookingId        String    @unique
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  propertyTitle    String
  propertyLocation String
  propertyState    String
  rentAmount       Int
  priceUnit        PriceUnit
  leaseStartDate   DateTime
  leaseEndDate     DateTime
  landlordName     String
  landlordEmail    String
  landlordPhone    String?
  tenantName       String
  tenantEmail      String
  tenantPhone      String?
  generatedAt      DateTime  @default(now())
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

/// A vendor "shop" — one per VENDOR-role User (1:1, hence the unique
/// userId). Phone/address reuse User.phoneNumber/houseAddress rather than
/// duplicating them here; everything shop-specific (business identity,
/// payout details) lives on this model. [isActive] false hides every one
/// of the vendor's products from the public catalog — "Deactivate Shop"
/// in the app.
model VendorProfile {
  id              String                  @id @default(uuid())
  userId          String                  @unique
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  category        MarketplaceCategory
  state           String
  rcNumber        String?
  logoUrl         String?
  /// Payout account — mirrors User's landlord payout fields exactly
  /// (bankCode added alongside this comment for parity, since a Transfer
  /// needs the bank code, not just its name). [accountName] must only
  /// ever be set from Paystack's own account-resolution response, never
  /// trusted from client input, same rule as User.accountName.
  bankCode        String?
  bankName        String?
  accountNumber   String?
  accountName     String?
  /// Vendor's own "Deactivate Shop" toggle — distinct from [status] below
  /// (the one-time onboarding moderation gate) and from [suspendedAt]
  /// (admin moderation). A shop is visible only when both this is true
  /// AND [suspendedAt] is null — see MarketplaceProductsService.findMany.
  isActive        Boolean                 @default(true)
  /// Set by an admin via suspendVendor/cleared via unsuspendVendor. Kept
  /// separate from [isActive] so a suspended vendor can't undo the
  /// suspension themselves through the self-service toggle.
  suspendedAt     DateTime?
  /// New vendors start PENDING and aren't shown in the public product
  /// feed (see MarketplaceProductsService.findMany) until an admin
  /// approves them. Existing vendors from before this field was added
  /// were backfilled to APPROVED (see the migration) so nothing already
  /// live went dark.
  status          VendorApplicationStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  products   Product[]
  orderItems MarketplaceOrderItem[]

  @@index([category])
  @@index([status])
}

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// [isAvailable] false is a soft delete — "Delete" in the vendor's "My
/// Products" screen sets this instead of removing the row, since a hard
/// delete would orphan any past MarketplaceOrderItem that references it.
model Product {
  id                 String              @id @default(uuid())
  /// System-assigned, sequential and unique across every vendor product
  /// ever listed (its own sequence, independent of Property.listingNumber)
  /// — always visible to the owning vendor and to admins, visible to a
  /// buyer only once they've paid for it (see MarketplaceOrdersService's
  /// orderInclude and OrderHistoryScreen).
  listingNumber      Int                 @unique @default(autoincrement())
  vendorId           String
  vendor             VendorProfile       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name               String
  description        String
  price              Int
  stock              Int
  category           MarketplaceCategory
  imageUrls          String[]            @default([])
  videoUrl           String?
  fulfillmentOptions FulfillmentMethod[]
  isAvailable        Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  orderItems MarketplaceOrderItem[]
  reports    Report[]

  @@index([vendorId])
  @@index([category])
}

model MarketplaceOrder {
  id              String                   @id @default(uuid())
  buyerId         String
  buyer           User                     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  paymentMethod   MarketplacePaymentMethod
  customerName    String
  customerPhone   String
  customerAddress String
  createdAt       DateTime                 @default(now())

  items   MarketplaceOrderItem[]
  threads Thread[]

  @@index([buyerId])
}

/// Snapshots productName/unitPrice at purchase time — a later price or
/// name change on the product shouldn't retroactively change past
/// orders. Status/notificationRead are tracked per item (not per order)
/// since one order can span multiple vendors, each managing only their
/// own items.
model MarketplaceOrderItem {
  id               String            @id @default(uuid())
  orderId          String
  order            MarketplaceOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorId         String
  vendor           VendorProfile     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productName      String
  unitPrice        Int
  quantity         Int
  fulfillment      FulfillmentMethod
  status           OrderItemStatus   @default(PENDING)
  notificationRead Boolean           @default(false)
  /// Set together when the vendor marks a DELIVERY-fulfillment item as
  /// shipped (see MarketplaceOrdersService.shipItem) — populated from
  /// DeliveryProvider.createShipment's response. Both null until then;
  /// PICKUP-fulfillment items never get these set. See
  /// src/delivery/delivery-provider.interface.ts for the caveat that the
  /// real GIG Logistics shape behind this is unverified.
  shipmentId       String?
  trackingNumber   String?
  /// Set alongside [shipmentId] — when the 7-day marketplace auto-release
  /// cron starts counting from for a DELIVERY-fulfillment item (a PICKUP
  /// item instead counts from Payment.paidAt, since it never ships). See
  /// MarketplaceAutoReleaseService.
  shippedAt        DateTime?

  payment Payment?

  @@index([orderId])
  @@index([vendorId])
}
